+<nb-card class="productivity">
+	<nb-card-body [nbSpinner]="loading" nbSpinnerStatus="primary">
+		<!-- Legend always present: identity is never colour alone. -->
+		<div class="chart-legend">
+			<span><i class="sw productive"></i>Productive</span>
+			<span><i class="sw neutral"></i>Neutral</span>
+			<span><i class="sw unproductive"></i>Unproductive</span>
+			<span><i class="sw idle"></i>Idle</span>
+			<span><i class="sw untracked"></i>Not tracked</span>
+		</div>
+
+		<div *ngIf="note" class="text-hint">{{ note }}</div>
+
+		<div class="chart-scroll" *ngIf="bars.length">
+			<svg class="chart" [attr.viewBox]="'0 0 ' + bars.length * 40 + ' 130'"
+				preserveAspectRatio="xMinYMin meet" role="img"
+				aria-label="Percentage of each hour spent productive, neutral, unproductive or idle">
+				<g class="grid">
+					<line *ngFor="let g of [0, 25, 50, 75, 100]" x1="0" [attr.x2]="bars.length * 40" [attr.y1]="g"
+						[attr.y2]="g" />
+					<text *ngFor="let g of [0, 50, 100]" x="0" [attr.y]="g - 1">{{ 100 - g }}%</text>
+				</g>
+				<g *ngFor="let b of bars; let i = index" [attr.transform]="'translate(' + i * 40 + ',0)'">
+					<rect class="seg productive" x="8" width="22" [attr.y]="segY(b, 'productive')"
+						[attr.height]="b.productive" rx="1">
+						<title>{{ b.label }} — Productive {{ b.productive | number: '1.0-0' }}%</title>
+					</rect>
+					<rect class="seg neutral" x="8" width="22" [attr.y]="segY(b, 'neutral')" [attr.height]="b.neutral"
+						rx="1">
+						<title>{{ b.label }} — Neutral {{ b.neutral | number: '1.0-0' }}%</title>
+					</rect>
+					<rect class="seg unproductive" x="8" width="22" [attr.y]="segY(b, 'unproductive')"
+						[attr.height]="b.unproductive" rx="1">
+						<title>{{ b.label }} — Unproductive {{ b.unproductive | number: '1.0-0' }}%</title>
+					</rect>
+					<rect class="seg idle" x="8" width="22" [attr.y]="segY(b, 'idle')" [attr.height]="b.idle" rx="1">
+						<title>{{ b.label }} — Idle {{ b.idle | number: '1.0-0' }}% ({{ b.trackedMinutes }} min tracked)</title>
+					</rect>
+					<rect class="seg untracked" x="8" width="22" [attr.y]="segY(b, 'untracked')"
+						[attr.height]="b.untracked" rx="1">
+						<title>{{ b.label }} — Not tracked {{ b.untracked | number: '1.0-0' }}% (tracker not running)</title>
+					</rect>
+					<text class="xlabel" x="19" y="112">{{ b.label }}</text>
+				</g>
+			</svg>
+		</div>
+
+		<!-- Table view: the numbers never depend on colour. -->
+		<table class="table mt-3" *ngIf="bars.length">
+			<thead>
+				<tr>
+					<th>Hour</th>
+					<th>Productive</th>
+					<th>Neutral</th>
+					<th>Unproductive</th>
+					<th>Idle</th>
+					<th>Not tracked</th>
+					<th>Tracked</th>
+				</tr>
+			</thead>
+			<tbody>
+				<tr *ngFor="let b of bars">
+					<td>{{ b.label }}</td>
+					<td>{{ b.productive | number: '1.0-0' }}%</td>
+					<td>{{ b.neutral | number: '1.0-0' }}%</td>
+					<td>{{ b.unproductive | number: '1.0-0' }}%</td>
+					<td>{{ b.idle | number: '1.0-0' }}%</td>
+					<td>{{ b.untracked | number: '1.0-0' }}%</td>
+					<td>{{ b.trackedMinutes }} / 60 min</td>
+				</tr>
+				<tr class="totals">
+					<td><b>Day average</b></td>
+					<td><b>{{ dayAverage().productive | number: '1.0-0' }}%</b></td>
+					<td><b>{{ dayAverage().neutral | number: '1.0-0' }}%</b></td>
+					<td><b>{{ dayAverage().unproductive | number: '1.0-0' }}%</b></td>
+					<td><b>{{ dayAverage().idle | number: '1.0-0' }}%</b></td>
+					<td><b>{{ dayAverage().untracked | number: '1.0-0' }}%</b></td>
+					<td></td>
+				</tr>
+			</tbody>
+		</table>
+
+		<p class="text-hint mt-2" *ngIf="bars.length">
+			Idle is measured from the tracked time itself — the seconds in each hour with no keyboard,
+			mouse or (where enabled) media activity. The active remainder is split by which app was
+			<b>on screen</b>, since only one window holds focus at a time. Hours with no tracked time are
+			omitted rather than drawn empty.
+		</p>
+		<p class="text-hint" *ngIf="bars.length">
+			<b>Not tracked</b> is time the tracker was not running — logged out, or the machine off. It is
+			deliberately not counted as idle: idle means present but inactive, and the tracker cannot tell
+			someone who went home from someone working on another machine.
+		</p>
+	</nb-card-body>
+</nb-card>
