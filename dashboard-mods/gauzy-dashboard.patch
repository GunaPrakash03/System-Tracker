+++ b/apps/gauzy/src/app/pages/settings/tracker-settings/tracker-settings.component.ts
@@ -0,0 +1,188 @@
+import { Component, OnInit } from '@angular/core';
+import { HttpClient, HttpHeaders } from '@angular/common/http';
+import { Store } from '@gauzy/ui-core/core';
+import { firstValueFrom } from 'rxjs';
+
+/**
+ * System-Tracker settings, rendered inside the Gauzy settings shell.
+ *
+ * The data lives in the System-Tracker admin service, NOT in Gauzy — Gauzy has
+ * no per-employee screenshot interval (its screenshotFrequency is
+ * organisation-wide), no notion of media counting as idle, and no concept of an
+ * app being productive within a particular department. This page is a thin
+ * client over that service so those settings appear where an admin already
+ * works, without inventing Gauzy entities for them.
+ *
+ * The service verifies the caller's Gauzy token server-side and refuses anyone
+ * who is not a SUPER_ADMIN. The permission guard on this route only decides
+ * whether the menu entry is worth showing — it is not the access control.
+ */
+interface EmployeeRow {
+	id: string;
+	label: string;
+	interval: string;
+	mediaIdle: boolean;
+	departmentId: string;
+}
+
+@Component({
+	selector: 'ga-tracker-settings',
+	templateUrl: './tracker-settings.component.html',
+	standalone: false
+})
+export class TrackerSettingsComponent implements OnInit {
+	public tab: 'employees' | 'apps' = 'employees';
+	public loading = true;
+	public error = '';
+	public saved = '';
+
+	public employees: EmployeeRow[] = [];
+	public departments: { id: string; name: string }[] = [];
+
+	/** Intervals Gauzy itself offers, so the two agree. */
+	public readonly intervals = [
+		{ value: '', label: 'Default' },
+		{ value: '60', label: '1 minute' },
+		{ value: '180', label: '3 minutes' },
+		{ value: '300', label: '5 minutes' },
+		{ value: '600', label: '10 minutes' }
+	];
+	public readonly categories = ['Productive', 'Neutral', 'Unproductive'];
+
+	public appDept = '';
+	public apps: { name: string; category: string }[] = [];
+	public newApp = '';
+	public newAppCategory = 'Productive';
+
+	constructor(private readonly http: HttpClient, private readonly store: Store) {}
+
+	/**
+	 * Base URL of the admin service. Same host as the dashboard, fixed port —
+	 * the service runs on each admin's own machine beside Gauzy, so deriving the
+	 * host from the browser location keeps it correct whether that is localhost
+	 * or a LAN address, without a build-time constant to forget to change.
+	 */
+	private get base(): string {
+		return `${window.location.protocol}//${window.location.hostname}:8600`;
+	}
+
+	private get headers(): HttpHeaders {
+		return new HttpHeaders({ Authorization: `Bearer ${this.store.token}` });
+	}
+
+	async ngOnInit(): Promise<void> {
+		await this.load();
+	}
+
+	private async load(): Promise<void> {
+		this.loading = true;
+		this.error = '';
+		try {
+			const data: any = await firstValueFrom(
+				this.http.get(`${this.base}/api/admin/state`, { headers: this.headers })
+			);
+			this.departments = data.departments || [];
+			this.employees = (data.employees || []).map((e: any) => ({
+				id: e.id,
+				label: e.label,
+				interval: e.screenshot_interval_seconds ? String(e.screenshot_interval_seconds) : '',
+				mediaIdle: e.count_audio_as_active === false,
+				departmentId: e.department_id || ''
+			}));
+			if (!this.appDept && this.departments.length) {
+				this.appDept = this.departments[0].id;
+			}
+			await this.loadApps();
+		} catch (e: any) {
+			// A 403 here means the signed-in user is not a super admin; anything
+			// else almost always means the tracker admin service is not running.
+			this.error =
+				e?.status === 403
+					? 'Super admin permission is required for these settings.'
+					: `Cannot reach the tracker settings service on port 8600. Is it running? (${
+							e?.status || 'no response'
+					  })`;
+		} finally {
+			this.loading = false;
+		}
+	}
+
+	public async loadApps(): Promise<void> {
+		if (!this.appDept) {
+			this.apps = [];
+			return;
+		}
+		try {
+			const data: any = await firstValueFrom(
+				this.http.get(`${this.base}/api/categories?departmentId=${this.appDept}`, {
+					headers: this.headers
+				})
+			);
+			this.apps = Object.entries(data.apps || {}).map(([name, category]) => ({
+				name,
+				category: category as string
+			}));
+		} catch {
+			this.apps = [];
+		}
+	}
+
+	public async saveEmployee(row: EmployeeRow): Promise<void> {
+		this.saved = '';
+		try {
+			await firstValueFrom(
+				this.http.post(
+					`${this.base}/api/admin/employee`,
+					{
+						employee_id: row.id,
+						screenshot_interval_seconds: row.interval ? Number(row.interval) : null,
+						// false means "media is idle for this person"; null means
+						// "no opinion", leaving the workstation's own config to
+						// decide. Sending true would overrule a machine that
+						// deliberately set it false locally.
+						count_audio_as_active: row.mediaIdle ? false : null,
+						department_id: row.departmentId || null
+					},
+					{ headers: this.headers }
+				)
+			);
+			this.saved = `Saved ${row.label}. The tracker applies it within 60 seconds.`;
+		} catch {
+			this.error = 'Could not save. Check the tracker settings service.';
+		}
+	}
+
+	public async saveApp(name: string, category: string): Promise<void> {
+		if (!name || !this.appDept) return;
+		this.saved = '';
+		try {
+			await firstValueFrom(
+				this.http.post(
+					`${this.base}/api/admin/app`,
+					{ department_id: this.appDept, app_name: name, category },
+					{ headers: this.headers }
+				)
+			);
+			this.newApp = '';
+			this.saved = `Saved ${name}.`;
+			await this.loadApps();
+		} catch {
+			this.error = 'Could not save the app category.';
+		}
+	}
+
+	public async removeApp(name: string): Promise<void> {
+		try {
+			await firstValueFrom(
+				this.http.post(
+					`${this.base}/api/admin/app-delete`,
+					{ department_id: this.appDept, app_name: name },
+					{ headers: this.headers }
+				)
+			);
+			await this.loadApps();
+		} catch {
+			this.error = 'Could not remove the app.';
+		}
+	}
+}
