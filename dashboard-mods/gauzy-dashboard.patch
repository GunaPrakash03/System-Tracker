@@ -0,0 +1,215 @@
+<nb-card>
+	<nb-card-header class="d-flex justify-content-between align-items-center">
+		<h5 class="mb-0">Tracker Settings</h5>
+		<nb-button-group size="small">
+			<button nbButton [class.selected]="tab === 'employees'" (click)="tab = 'employees'">Employees</button>
+			<button nbButton [class.selected]="tab === 'apps'" (click)="tab = 'apps'">App productivity</button>
+			<button nbButton [class.selected]="tab === 'chart'" (click)="tab = 'chart'; loadChart()">Hourly chart</button>
+		</nb-button-group>
+	</nb-card-header>
+
+	<nb-card-body [nbSpinner]="loading" nbSpinnerStatus="primary">
+		<div *ngIf="error" class="alert alert-danger">{{ error }}</div>
+		<div *ngIf="saved" class="alert alert-success">{{ saved }}</div>
+
+		<!-- Employees -->
+		<div *ngIf="tab === 'employees'">
+			<p class="text-hint">
+				Applied by the tracker within 60 seconds — no restart. Leaving a value at
+				<b>Default</b> lets the workstation's own configuration decide.
+			</p>
+			<table class="table">
+				<thead>
+					<tr>
+						<th>Employee</th>
+						<th>Screenshot every</th>
+						<th>Media counts as idle</th>
+						<th>Blur screenshots</th>
+						<th>Department</th>
+						<th></th>
+					</tr>
+				</thead>
+				<tbody>
+					<tr *ngFor="let row of employees">
+						<td>{{ row.label }}</td>
+						<td>
+							<nb-select size="small" [(selected)]="row.interval">
+								<nb-option *ngFor="let i of intervals" [value]="i.value">{{ i.label }}</nb-option>
+							</nb-select>
+						</td>
+						<td><nb-toggle [(checked)]="row.mediaIdle"></nb-toggle></td>
+						<td><nb-toggle [(checked)]="row.blur"></nb-toggle></td>
+						<td>
+							<nb-select size="small" [(selected)]="row.departmentId">
+								<nb-option value="">—</nb-option>
+								<nb-option *ngFor="let d of departments" [value]="d.id">{{ d.name }}</nb-option>
+							</nb-select>
+						</td>
+						<td>
+							<button nbButton size="small" status="primary" (click)="saveEmployee(row)">Save</button>
+						</td>
+					</tr>
+					<tr *ngIf="!employees.length && !loading">
+						<td colspan="6" class="text-hint">No employees found.</td>
+					</tr>
+				</tbody>
+			</table>
+			<p class="text-hint">
+				A screenshot interval is snapped to the tracker's slot interval, because a screenshot
+				can only be attached to a time slot that exists. Asking for a shorter interval than the
+				slot captures once per slot rather than producing screenshots the dashboard cannot show.
+			</p>
+		</div>
+
+		<!-- App productivity -->
+		<div *ngIf="tab === 'apps'">
+			<p class="text-hint">
+				Stored in Gauzy against each employee, so there is no separate service to run.
+				Apps are matched on <b>process name</b> — what the tracker reports, such as
+				<code>chrome</code>, <code>code</code> or <code>postgres</code>. The same app can be
+				productive for one department and unproductive for another. Anything unclassified counts
+				as Neutral.
+			</p>
+			<nb-select [(selected)]="appDept" (selectedChange)="refreshApps()" placeholder="Department">
+				<nb-option *ngFor="let d of departments" [value]="d.id">{{ d.name }}</nb-option>
+			</nb-select>
+			<p *ngIf="!departments.length" class="text-hint mt-2">
+				No departments yet — add them under <b>Organization → Departments</b>, then they appear here.
+			</p>
+
+			<table class="table mt-3" *ngIf="appDept">
+				<thead>
+					<tr>
+						<th>Process name</th>
+						<th>Category</th>
+						<th></th>
+					</tr>
+				</thead>
+				<tbody>
+					<tr *ngFor="let a of apps">
+						<td>{{ a.name }}</td>
+						<td>
+							<nb-select size="small" [(selected)]="a.category">
+								<nb-option *ngFor="let c of categories" [value]="c">{{ c }}</nb-option>
+							</nb-select>
+						</td>
+						<td>
+							<button nbButton size="small" status="primary" (click)="saveApp(a.name, a.category)">
+								Save
+							</button>
+							<button nbButton size="small" status="danger" (click)="removeApp(a.name)">Remove</button>
+						</td>
+					</tr>
+					<tr>
+						<td><input nbInput fieldSize="small" [(ngModel)]="newApp" placeholder="e.g. spotify" /></td>
+						<td>
+							<nb-select size="small" [(selected)]="newAppCategory">
+								<nb-option *ngFor="let c of categories" [value]="c">{{ c }}</nb-option>
+							</nb-select>
+						</td>
+						<td>
+							<button nbButton size="small" status="success" (click)="saveApp(newApp, newAppCategory)">
+								Add
+							</button>
+						</td>
+					</tr>
+				</tbody>
+			</table>
+		</div>
+		<!-- Hourly productivity -->
+		<div *ngIf="tab === 'chart'" class="tracker-chart">
+			<div class="chart-filters">
+				<nb-select size="small" [(selected)]="chartEmployeeId" (selectedChange)="loadChart()"
+					placeholder="Employee">
+					<nb-option *ngFor="let e of employees" [value]="e.id">{{ e.label }}</nb-option>
+				</nb-select>
+				<input nbInput fieldSize="small" type="date" [(ngModel)]="chartDate" (change)="loadChart()" />
+				<button nbButton size="small" (click)="loadChart()">Refresh</button>
+			</div>
+
+			<!-- Legend: identity is never colour alone. -->
+			<div class="chart-legend">
+				<span><i class="sw productive"></i>Productive</span>
+				<span><i class="sw neutral"></i>Neutral</span>
+				<span><i class="sw unproductive"></i>Unproductive</span>
+				<span><i class="sw idle"></i>Idle</span>
+			</div>
+
+			<div *ngIf="chartNote" class="text-hint">{{ chartNote }}</div>
+			<div *ngIf="chartLoading" class="text-hint">Loading…</div>
+
+			<div class="chart-scroll" *ngIf="chartBars.length">
+				<svg class="chart" [attr.viewBox]="'0 0 ' + chartBars.length * 40 + ' 130'"
+					preserveAspectRatio="xMinYMin meet" role="img"
+					aria-label="Percentage of each hour spent productive, neutral, unproductive or idle">
+					<!-- recessive gridlines at 0/25/50/75/100% -->
+					<g class="grid">
+						<line *ngFor="let g of [0, 25, 50, 75, 100]" x1="0" [attr.x2]="chartBars.length * 40"
+							[attr.y1]="g" [attr.y2]="g" />
+						<text *ngFor="let g of [0, 50, 100]" x="0" [attr.y]="g - 1">{{ 100 - g }}%</text>
+					</g>
+					<g *ngFor="let b of chartBars; let i = index" [attr.transform]="'translate(' + i * 40 + ',0)'">
+						<!-- 2px surface gap between segments; ends rounded on the stack -->
+						<rect class="seg productive" x="8" width="22" [attr.y]="segY(b, 'productive')"
+							[attr.height]="b.productive" rx="1">
+							<title>{{ b.label }} — Productive {{ b.productive | number: '1.0-0' }}%</title>
+						</rect>
+						<rect class="seg neutral" x="8" width="22" [attr.y]="segY(b, 'neutral')"
+							[attr.height]="b.neutral" rx="1">
+							<title>{{ b.label }} — Neutral {{ b.neutral | number: '1.0-0' }}%</title>
+						</rect>
+						<rect class="seg unproductive" x="8" width="22" [attr.y]="segY(b, 'unproductive')"
+							[attr.height]="b.unproductive" rx="1">
+							<title>{{ b.label }} — Unproductive {{ b.unproductive | number: '1.0-0' }}%</title>
+						</rect>
+						<rect class="seg idle" x="8" width="22" [attr.y]="segY(b, 'idle')" [attr.height]="b.idle"
+							rx="1">
+							<title>{{ b.label }} — Idle {{ b.idle | number: '1.0-0' }}% ({{ b.trackedMinutes }} min tracked)</title>
+						</rect>
+						<text class="xlabel" x="19" y="112">{{ b.label }}</text>
+					</g>
+				</svg>
+			</div>
+
+			<!-- Table view: the relief for the sub-3:1 contrast warning, and the
+			     answer for anyone who cannot read the chart at all. -->
+			<table class="table mt-3" *ngIf="chartBars.length">
+				<thead>
+					<tr>
+						<th>Hour</th>
+						<th>Productive</th>
+						<th>Neutral</th>
+						<th>Unproductive</th>
+						<th>Idle</th>
+						<th>Tracked</th>
+					</tr>
+				</thead>
+				<tbody>
+					<tr *ngFor="let b of chartBars">
+						<td>{{ b.label }}</td>
+						<td>{{ b.productive | number: '1.0-0' }}%</td>
+						<td>{{ b.neutral | number: '1.0-0' }}%</td>
+						<td>{{ b.unproductive | number: '1.0-0' }}%</td>
+						<td>{{ b.idle | number: '1.0-0' }}%</td>
+						<td>{{ b.trackedMinutes }} min</td>
+					</tr>
+					<tr class="totals">
+						<td><b>Day average</b></td>
+						<td><b>{{ dayTotals().productive | number: '1.0-0' }}%</b></td>
+						<td><b>{{ dayTotals().neutral | number: '1.0-0' }}%</b></td>
+						<td><b>{{ dayTotals().unproductive | number: '1.0-0' }}%</b></td>
+						<td><b>{{ dayTotals().idle | number: '1.0-0' }}%</b></td>
+						<td></td>
+					</tr>
+				</tbody>
+			</table>
+
+			<p class="text-hint mt-2">
+				Idle comes from the tracked time itself — the seconds in each hour with no keyboard, mouse
+				or (where enabled) media activity. The active remainder is split by which app was
+				<b>on screen</b>, since only one window has focus at a time. Hours with no tracked time are
+				omitted rather than drawn as empty.
+			</p>
+		</div>
+	</nb-card-body>
+</nb-card>
