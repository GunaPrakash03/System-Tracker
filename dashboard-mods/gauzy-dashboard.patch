--- /dev/null
+++ b/apps/gauzy/src/app/pages/settings/tracker-settings/tracker-settings.component.ts
@@ -0,0 +1,353 @@
+import { Component, OnInit } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { Store } from '@gauzy/ui-core/core';
+import { firstValueFrom } from 'rxjs';
+
+/**
+ * System-Tracker settings.
+ *
+ * Everything here is stored in GAUZY ITSELF — in the generic `employee_setting`
+ * table, a per-employee row with a jsonb `data` column — and reached through
+ * Gauzy's own API with the session the dashboard already holds. There is no
+ * separate settings service, no second port and no extra process to keep alive.
+ *
+ * Gauzy has no field of its own for any of these: `screenshotFrequency` is
+ * organisation-wide rather than per employee, there is no notion of media
+ * counting as idle, and none of an app being productive within a department.
+ * The generic settings row is what lets all three live here without forking
+ * Gauzy's backend to add tables.
+ */
+interface EmployeeRow {
+	id: string;
+	label: string;
+	interval: string;
+	mediaIdle: boolean;
+	blur: boolean;
+	departmentId: string;
+	settingId?: string;
+}
+
+/** One hour's stacked bar: four shares that always total 100. */
+interface HourBar {
+	hour: number;
+	label: string;
+	productive: number;
+	neutral: number;
+	unproductive: number;
+	idle: number;
+	trackedMinutes: number;
+}
+
+@Component({
+	selector: 'ga-tracker-settings',
+	templateUrl: './tracker-settings.component.html',
+	styleUrls: ['./tracker-settings.component.scss'],
+	standalone: false
+})
+export class TrackerSettingsComponent implements OnInit {
+	public tab: 'employees' | 'apps' | 'chart' = 'employees';
+
+	// ---- productivity chart ----
+	public chartEmployeeId = '';
+	public chartDate = new Date().toISOString().slice(0, 10);
+	public chartBars: HourBar[] = [];
+	public chartLoading = false;
+	public chartNote = '';
+	public loading = true;
+	public error = '';
+	public saved = '';
+
+	public employees: EmployeeRow[] = [];
+	public departments: { id: string; name: string }[] = [];
+
+	/** The intervals Gauzy itself offers, so the two agree. */
+	public readonly intervals = [
+		{ value: '', label: 'Default' },
+		{ value: '60', label: '1 minute' },
+		{ value: '180', label: '3 minutes' },
+		{ value: '300', label: '5 minutes' },
+		{ value: '600', label: '10 minutes' }
+	];
+	public readonly categories = ['Productive', 'Neutral', 'Unproductive'];
+
+	public appDept = '';
+	public apps: { name: string; category: string }[] = [];
+	public newApp = '';
+	public newAppCategory = 'Productive';
+
+	/**
+	 * departmentId -> { processName: category }.
+	 *
+	 * Held on every employee's settings row rather than on the department,
+	 * because `organization_department` has no free-text or JSON column and
+	 * `tenant_setting` rejects keys other than its own. Writing the same map to
+	 * each employee is the price of not forking Gauzy's backend to add a table;
+	 * the map is small and this page is its only writer.
+	 */
+	private appCategories: Record<string, Record<string, string>> = {};
+
+	constructor(private readonly http: HttpClient, private readonly store: Store) {}
+
+	private get scope(): string {
+		return `where[tenantId]=${this.store.user?.tenantId}&where[organizationId]=${this.store.selectedOrganization?.id}`;
+	}
+
+	async ngOnInit(): Promise<void> {
+		await this.load();
+	}
+
+	private async load(): Promise<void> {
+		this.loading = true;
+		this.error = '';
+		try {
+			const orgId = this.store.selectedOrganization?.id;
+			const tenantId = this.store.user?.tenantId;
+
+			const [emps, depts, settings]: any[] = await Promise.all([
+				firstValueFrom(
+					this.http.get(`/api/employee?${this.scope}&relations[0]=user`)
+				),
+				firstValueFrom(this.http.get(`/api/organization-department?${this.scope}`)),
+				firstValueFrom(this.http.get(`/api/employee-settings?${this.scope}`))
+			]);
+
+			this.departments = (depts?.items || depts || []).map((d: any) => ({
+				id: d.id,
+				name: d.name || '(unnamed)'
+			}));
+
+			// Newest row wins: saving writes a fresh row rather than mutating the
+			// old one, so an employee accumulates history and only the last entry
+			// reflects what the admin currently intends.
+			const byEmployee: Record<string, any> = {};
+			for (const s of settings?.items || settings || []) {
+				if (s?.employeeId) byEmployee[s.employeeId] = s;
+			}
+
+			this.employees = (emps?.items || emps || []).map((e: any) => {
+				const user = e.user || {};
+				const data = byEmployee[e.id]?.data || {};
+				if (data.app_categories) this.appCategories = data.app_categories;
+				return {
+					id: e.id,
+					label:
+						user.name ||
+						[user.firstName, user.lastName].filter(Boolean).join(' ') ||
+						user.email ||
+						e.id.slice(0, 8),
+					interval: data.screenshot_interval_seconds ? String(data.screenshot_interval_seconds) : '',
+					mediaIdle: data.count_audio_as_active === false,
+					blur: data.blur_screenshots === true,
+					departmentId: data.department_id || '',
+					settingId: byEmployee[e.id]?.id
+				};
+			});
+
+			if (!this.appDept && this.departments.length) this.appDept = this.departments[0].id;
+			this.refreshApps();
+			if (!orgId || !tenantId) {
+				this.error = 'No organization selected — pick one in the header first.';
+			}
+		} catch (e: any) {
+			this.error = `Could not load settings from Gauzy (HTTP ${e?.status || '?'}).`;
+		} finally {
+			this.loading = false;
+		}
+	}
+
+	public refreshApps(): void {
+		const map = this.appCategories[this.appDept] || {};
+		this.apps = Object.entries(map).map(([name, category]) => ({ name, category }));
+	}
+
+	/** Write one employee's settings row. */
+	private async persist(row: EmployeeRow): Promise<void> {
+		await firstValueFrom(
+			this.http.post('/api/employee-settings', {
+				employeeId: row.id,
+				organizationId: this.store.selectedOrganization?.id,
+				tenantId: this.store.user?.tenantId,
+				entity: 'Employee',
+				entityId: row.id,
+				settingType: 'Custom',
+				data: {
+					screenshot_interval_seconds: row.interval ? Number(row.interval) : null,
+					// false means "media is idle for this person"; null means "no
+					// opinion", leaving the workstation's own config to decide.
+					// Sending true would overrule a machine that deliberately set
+					// it false locally.
+					count_audio_as_active: row.mediaIdle ? false : null,
+					// Unlike media-as-idle, true is meaningful here: blurring is a
+					// promise to the employee, so an admin turning it on must
+					// override a workstation config that left it off.
+					blur_screenshots: row.blur ? true : null,
+					department_id: row.departmentId || null,
+					app_categories: this.appCategories
+				}
+			})
+		);
+	}
+
+	public async saveEmployee(row: EmployeeRow): Promise<void> {
+		this.saved = '';
+		this.error = '';
+		try {
+			await this.persist(row);
+			this.saved = `Saved ${row.label}. The tracker applies it within 60 seconds.`;
+		} catch (e: any) {
+			this.error = `Could not save (HTTP ${e?.status || '?'}).`;
+		}
+	}
+
+	/**
+	 * App categories belong to a department, but are stored per employee, so a
+	 * change has to be written to everyone. Small N and this page is the only
+	 * writer, so a straightforward loop is enough.
+	 */
+	private async persistCategories(): Promise<void> {
+		this.saved = '';
+		this.error = '';
+		try {
+			for (const row of this.employees) {
+				await this.persist(row);
+			}
+			this.saved = 'Saved. The tracker applies it within 60 seconds.';
+		} catch (e: any) {
+			this.error = `Could not save (HTTP ${e?.status || '?'}).`;
+		}
+	}
+
+	public async saveApp(name: string, category: string): Promise<void> {
+		const app = (name || '').trim().toLowerCase();
+		if (!app || !this.appDept) return;
+		this.appCategories[this.appDept] = { ...(this.appCategories[this.appDept] || {}), [app]: category };
+		this.newApp = '';
+		this.refreshApps();
+		await this.persistCategories();
+	}
+
+	public async removeApp(name: string): Promise<void> {
+		if (!this.appCategories[this.appDept]) return;
+		delete this.appCategories[this.appDept][name];
+		this.refreshApps();
+		await this.persistCategories();
+	}
+
+	// ---------------------------------------------------------------- chart --
+	//
+	// Two sources, because neither alone can answer the question:
+	//
+	//   time slots  -> `duration` and `overall` per bucket. This is the ONLY
+	//                  honest source of idle time: overall is the seconds the
+	//                  employee was actually active, so idle is the remainder.
+	//   activities  -> per-app `metaData.foregroundSeconds`, which splits the
+	//                  active time by category.
+	//
+	// An activity's own `duration` is NOT usable as a weight: the tracker posts
+	// every running process with the full slot duration, so on a machine running
+	// sixteen processes they sum to sixteen times the wall clock. Foreground
+	// seconds are non-overlapping — only one window has focus at a time — which
+	// is what makes them a valid basis for a percentage.
+
+	public async loadChart(): Promise<void> {
+		const emp = this.chartEmployeeId || this.employees[0]?.id;
+		if (!emp || !this.chartDate) return;
+		this.chartLoading = true;
+		this.chartNote = '';
+		this.chartBars = [];
+		try {
+			const from = encodeURIComponent(`${this.chartDate} 00:00:00`);
+			const to = encodeURIComponent(`${this.chartDate} 23:59:59`);
+			const scope = `${this.scope}&organizationId=${this.store.selectedOrganization?.id}&tenantId=${this.store.user?.tenantId}`;
+			const [slots, acts]: any[] = await Promise.all([
+				firstValueFrom(
+					this.http.get(
+						`/api/timesheet/time-slot?startDate=${from}&endDate=${to}&${scope}&employeeIds[0]=${emp}`
+					)
+				),
+				firstValueFrom(
+					this.http.get(
+						`/api/timesheet/activity?activityType=APP&startDate=${from}&endDate=${to}&${scope}&employeeIds[0]=${emp}`
+					)
+				)
+			]);
+
+			const dept = this.employees.find((e) => e.id === emp)?.departmentId || '';
+			const cats = this.appCategories[dept] || {};
+
+			// wall + active seconds per hour, from the slots
+			const wall: number[] = new Array(24).fill(0);
+			const active: number[] = new Array(24).fill(0);
+			for (const s of slots?.items || slots || []) {
+				const h = new Date(s.startedAt).getHours();
+				wall[h] += Number(s.duration || 0);
+				active[h] += Number(s.overall || 0);
+			}
+
+			// foreground seconds per hour per category, from the activities
+			const fg: Record<string, number>[] = Array.from({ length: 24 }, () => ({
+				Productive: 0,
+				Neutral: 0,
+				Unproductive: 0
+			}));
+			for (const a of acts?.items || acts || []) {
+				const meta = Array.isArray(a.metaData) ? a.metaData[0] : a.metaData;
+				const secs = Number(meta?.foregroundSeconds || 0);
+				if (!secs) continue;
+				const h = Number(String(a.time || '00:00:00').slice(0, 2));
+				const cat = cats[String(a.title || '').toLowerCase()] || 'Neutral';
+				if (fg[h][cat] !== undefined) fg[h][cat] += secs;
+			}
+
+			const bars: HourBar[] = [];
+			for (let h = 0; h < 24; h++) {
+				if (!wall[h]) continue;
+				const idlePct = Math.max(0, Math.min(100, ((wall[h] - active[h]) / wall[h]) * 100));
+				const activePct = 100 - idlePct;
+				const totalFg = fg[h].Productive + fg[h].Neutral + fg[h].Unproductive;
+				// With no focused window all hour — a headless build, or a locked
+				// screen that still registered input — there is nothing to split
+				// the active time by, so it falls to Neutral rather than being
+				// silently dropped or inflating Productive.
+				const share = (c: string) => (totalFg ? (fg[h][c] / totalFg) * activePct : c === 'Neutral' ? activePct : 0);
+				bars.push({
+					hour: h,
+					label: `${String(h).padStart(2, '0')}:00`,
+					productive: share('Productive'),
+					neutral: share('Neutral'),
+					unproductive: share('Unproductive'),
+					idle: idlePct,
+					trackedMinutes: Math.round(wall[h] / 60)
+				});
+			}
+			this.chartBars = bars;
+			if (!bars.length) this.chartNote = 'No tracked time for this employee on this date.';
+		} catch (e: any) {
+			this.chartNote = `Could not load activity (HTTP ${e?.status || '?'}).`;
+		} finally {
+			this.chartLoading = false;
+		}
+	}
+
+	/** y for a stacked segment, in a 0–100 viewBox measured from the top. */
+	public segY(bar: HourBar, seg: 'productive' | 'neutral' | 'unproductive' | 'idle'): number {
+		const order: Array<keyof HourBar> = ['productive', 'neutral', 'unproductive', 'idle'];
+		let acc = 0;
+		for (const k of order) {
+			if (k === seg) break;
+			acc += bar[k] as number;
+		}
+		return 100 - acc - (bar[seg] as number);
+	}
+
+	public dayTotals(): { productive: number; neutral: number; unproductive: number; idle: number } {
+		const n = this.chartBars.length || 1;
+		const sum = (k: keyof HourBar) => this.chartBars.reduce((t, b) => t + (b[k] as number), 0) / n;
+		return {
+			productive: sum('productive'),
+			neutral: sum('neutral'),
+			unproductive: sum('unproductive'),
+			idle: sum('idle')
+		};
+	}
+}
