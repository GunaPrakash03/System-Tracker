  "exclude": [
    "sandbox",
    "crashpad",
    "crash.?handler",
    "-helper",
    "gpu.?process",
    "utility",
    "zygote",
    "broker"
  ],
  "cpu_min_percent": 1.0,
  "max_processes": 40,
  "idle_threshold_seconds": 180,
  "count_audio_as_active": true,
  "capture_screenshots": true,
  "screenshot_max_width": 800,
  "screenshot_jpeg_quality": 75,
  "screenshot_gate": "dashboard",
  "screenshot_gate_refresh_seconds": 30,
  "screenshot_method": "gnome",
  "screenshot_timeout_seconds": 20,
  "maintain_timer": true,
  "timer_source": "DESKTOP",
  "enforce_timer": true,
  "stop_timer_on_exit": false,
  "use_local_time": false,
  "use_network_time": true,
  "clock_skew_warn_seconds": 30,
  "spool_offline_slots": true,
  "spool_path": null,
  "spool_max_slots": 2880,
  "spool_max_age_hours": 72,
  "spool_flush_per_cycle": 30,
  "verbose": true
}
