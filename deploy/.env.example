# Copy to deploy/.env and fill in. That file is gitignored — never commit it.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env

# The one endpoint. Everything — browsers and every tracker — uses this and
# nothing else. Behind a domain, set the https URL here and leave PUBLIC_PORT
# to whatever your proxy forwards to.
PUBLIC_URL=http://localhost:8080
PUBLIC_PORT=8080

# Database. The container is not published, so this password guards the
# internal network only — but pick a real one anyway.
DB_NAME=gauzy
DB_USER=postgres
DB_PASS=

# Secrets. Generate each separately, e.g. `openssl rand -hex 32`.
# Do NOT reuse Ever's published defaults (secretKey / refreshSecretKey / gauzy)
# — they appear in render.yaml and will mint valid tokens for anyone.
JWT_SECRET=
JWT_REFRESH_TOKEN_SECRET=
EXPRESS_SESSION_SECRET=

# Optional: deploy prebuilt images instead of building from gauzy/.
# API_IMAGE=ghcr.io/<org>/tracker-api:<tag>
# WEBAPP_IMAGE=ghcr.io/<org>/tracker-webapp:<tag>
